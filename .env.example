# ==========================================
# Personal Job Search & Tracking Board (.env)
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==========================================

# 1. Database (PostgreSQL / Neon Serverless)
# Format: postgresql://[user]:[password]@[endpoint-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Whitelisted email address(es) permitted to access the dashboard (comma-separated for multiple users)
ALLOWED_EMAIL="owner@example.com,collaborator@example.com"
AUTH_PASSWORD="your_secure_admin_password"
JWT_SECRET="generate_a_super_secret_key_at_least_32_chars_long"

# Google OAuth Credentials (console.cloud.google.com)
# Authorized redirect URI: http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Telegram Bot & Webhook Integration
# Shared secret token sent by Telegram in header 'X-Telegram-Bot-Api-Secret-Token'
TELEGRAM_WEBHOOK_SECRET="your_telegram_webhook_secret_token"
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# 4. Pluggable AI Extraction Layer
# Options: "deepseek" | "openai"
LLM_PROVIDER="deepseek"

# DeepSeek Configuration (Default - cost-effective extraction)
DEEPSEEK_API_KEY="sk-your_deepseek_api_key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# OpenAI Configuration (Switchable)
OPENAI_API_KEY="sk-your_openai_api_key"
OPENAI_BASE_URL="https://api.openai.com/v1"
